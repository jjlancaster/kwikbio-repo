# Google Cloud Project — used to resolve all other secrets at runtime
GCP_PROJECT_ID=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/hydrojoule

# NextAuth public URL
NEXTAUTH_URL=http://localhost:3001

# All remaining secrets are fetched from GCP Secret Manager at runtime.
# Create the following secrets in your GCP project:
#
#   NEXTAUTH_SECRET          — random 32-byte hex string (openssl rand -hex 32)
#   GOOGLE_CLIENT_ID         — OAuth 2.0 client ID from Google Cloud Console
#   GOOGLE_CLIENT_SECRET     — OAuth 2.0 client secret from Google Cloud Console
#   EMAIL_SERVER_HOST        — SMTP host (e.g. smtp.resend.com)
#   EMAIL_SERVER_PORT        — SMTP port (e.g. 465)
#   EMAIL_SERVER_USER        — SMTP username / API key identifier
#   EMAIL_SERVER_PASSWORD    — SMTP password / Resend API key
#   EMAIL_FROM               — Sender address (e.g. noreply@hydrojoule.ai)
#   TELEGRAM_BOT_TOKEN       — Telegram bot token for deploy gatekeeper
